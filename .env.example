# ==============================================================================
# CARBON MIRROR - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Firebase Client SDK Credentials
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_app_id_here
FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID_here

# Google Maps API Credentials (Client-side distance calculations)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gemini API Credentials (Used securely server-side in Cloud Functions)
GEMINI_API_KEY=your_gemini_api_key_here

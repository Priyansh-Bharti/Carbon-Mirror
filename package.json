{
  "name": "carbon-mirror",
  "version": "1.0.0",
  "description": "Carbon Mirror - Carbon footprint awareness web application for PromptWars 2026",
  "main": "functions/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit tests/integration --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --coverage",
    "test:watch": "node --test --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report coverage/playwright-report",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint \"public/js/**/*.js\" \"functions/**/*.js\" --max-warnings=15",
    "lint:fix": "eslint \"public/js/**/*.js\" \"functions/**/*.js\" --fix",
    "lint:secrets": "grep -rinE 'AIza|p2-o-fcb5d|maps.googleapis.com.*key=' public/ functions/ || echo \"No hardcoded secrets found.\"",
    "format": "prettier --write \"public/js/**/*.js\" \"functions/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"public/js/**/*.js\" \"functions/**/*.js\"",
    "pretest": "npm run lint",
    "predeploy": "npm run lint:secrets && npm run test",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^12.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.4"
  },
  "private": true
}
